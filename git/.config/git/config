[user]
	email = ucraaa@gmail.com
	name = Gabriel Henrique Rudey

[core]
	rebase = true
	excludesfile = ~/.config/git/ignore
	pager = bat

[credential]
	helper = cache --timeout=120

[alias]
	s = switch
	rebranch = rebase -i origin/master
	recommit = commit --amend --no-edit
	repush = push --force-with-lease origin HEAD
	uncommit = reset --soft HEAD~
	no-hooks = config core.hooksPath /dev/null
	re-hooks = config --unset core.hooksPath
	other-name = rev-parse --abbrev-ref @{-1}
	diff-hashes = log --pretty=format:"%H" --reverse
	pick-diff = "!zsh -c 'f() { git diff-hashes $@ | paste -s -d \" \" - | xargs git cherry-pick }; f $0'"
[init]
	defaultBranch = main
[pull]
	rebase = true
[branch]
	sort = -committerdate

# config-local is an ignored file to be defined by the env/machine that is
# running this git instance. For example, specific git configs for a company
# laptop or personal preferences
[include]
	path = "~/.config/git/config-local"
[push]
	autoSetupRemote = true
	default = current
[diff]
	tool = nvimdiff
[difftool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\"
[merge]
	tool = nvimdiff
